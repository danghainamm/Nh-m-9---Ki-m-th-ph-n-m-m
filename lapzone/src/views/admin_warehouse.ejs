<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý Kho</title>
  <link rel="stylesheet" href="/css/dashboard_qtv.css" />
  <link rel="stylesheet" href="/css/admin_warehouse.css" />
<link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <!-- ===== HEADER ===== -->
  <header class="header">
    <div class="header-left">
      <div><a href="/qtv/trangchu"><img src="/images/logo.png" alt="Logo" class="logo-header" /></a></div>
    </div>
    <div class="user-info">
      <div class="username">
        <%= quanTriVien ? quanTriVien.hoTen : 'Admin' %>
      </div>
      <a href="/logout" class="logout">Đăng xuất</a>
    </div>
  </header>

  <div class="container">
    <!-- ===== SIDEBAR ===== -->
    <div class="sidebar">
      <ul class="menu">
        <li><a href="/quanlytaikhoan">Quản lý tài khoản khách hàng</a></li>
        <li><a href="/quanlysanpham">Quản lý sản phẩm</a></li>
        <li><a href="/quanlydonhang">Quản lý đơn hàng</a></li>
        <li><a href="/xembaocao">Xem báo cáo</a></li>
        <li class="active"><a href="/quanlykho">Quản lý kho</a></li>
      </ul>
    </div>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="main-content">
      <div class="content-header">
        <h1 class="page-title">Kho hàng</h1>
        <div class="actions">
          <button class="btn btn-primary" onclick="openImportModal()">Import</button>
          <button class="btn btn-secondary" onclick="exportToFile()">Xuất file</button>
        </div>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert <%= message.includes('Lỗi') ? 'alert-error' : 'alert-success' %>">
          <%= message %>
        </div>
      <% } %>

      <!-- Thống kê tổng quan -->
      <% if (typeof statistics !== 'undefined' && statistics) {
        const tongGiaTri = parseFloat(statistics.tongGiaTriKho) || 0;
        let displayValue = '';
        let unit = '';

        if (tongGiaTri >= 1000000000) {
          // Tỷ đồng
          displayValue = (tongGiaTri / 1000000000).toFixed(2);
          unit = ' tỷ';
        } else if (tongGiaTri >= 1000000) {
          // Triệu đồng
          displayValue = (tongGiaTri / 1000000).toFixed(0);
          unit = ' tr';
        } else {
          // Dưới triệu
          displayValue = tongGiaTri.toLocaleString('vi-VN');
          unit = '';
        }
      %>
        <div class="statistics-cards">
          <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-info">
              <div class="stat-label">Tổng sản phẩm</div>
              <div class="stat-value"><%= statistics.tongSanPham %></div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">📊</div>
            <div class="stat-info">
              <div class="stat-label">Tổng tồn kho</div>
              <div class="stat-value"><%= statistics.tongTonKho %></div>
            </div>
          </div>
          <div class="stat-card info">
            <div class="stat-icon">💰</div>
            <div class="stat-info">
              <div class="stat-label">Tổng giá trị kho</div>
              <div class="stat-value"><%= displayValue %><span style="font-size: 16px;"><%= unit %></span></div>
            </div>
          </div>
          <div class="stat-card success">
            <div class="stat-icon">✅</div>
            <div class="stat-info">
              <div class="stat-label">Còn hàng</div>
              <div class="stat-value"><%= statistics.soLuongConHang %></div>
            </div>
          </div>
          <div class="stat-card warning">
            <div class="stat-icon">⚠️</div>
            <div class="stat-info">
              <div class="stat-label">Sắp hết</div>
              <div class="stat-value"><%= statistics.sanPhamSapHet %></div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Search bar -->
      <div class="search-section">
        <button class="filter-icon" type="button" onclick="toggleFilters()">Tất cả tồn kho</button>
        <form action="/quanlykho/search" method="GET" class="search-form">
          <input
            type="text"
            name="keyword"
            placeholder="Tìm kiếm..."
            value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
            class="search-input"
          />
          <button type="submit" class="btn-search">🔍</button>
        </form>
      </div>

      <!-- Table -->
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Mã sản phẩm</th>
              <th>Tên sản phẩm</th>
              <th>Model</th>
              <th>Giá nhập</th>
              <th>Giá bán</th>
              <th>Trạng thái</th>
              <th>Tồn kho</th>
              <th>Đã bán</th>
              <th>Ngày bán đầu</th>
              <th>Tổng giá trị</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(product => {
                const giaNhap = parseFloat(product.giaNhap) || 0;
                const giaBan = parseFloat(product.giaBan) || 0;
                const soLuongTon = parseInt(product.soLuongTon) || 0;
                const tongGiaTri = giaNhap * soLuongTon;
              %>
                <tr data-stock="<%= soLuongTon %>">
                  <td><%= product.maSanPham %></td>
                  <td><%= product.tenSanPham %></td>
                  <td><%= product.model || 'N/A' %></td>
                  <td><%= giaNhap.toLocaleString('vi-VN') %></td>
                  <td><%= giaBan.toLocaleString('vi-VN') %></td>
                  <td>
                    <span class="status <%= product.tinhTrang === 'Còn hàng' ? 'status-active' : 'status-inactive' %>">
                      <%= product.tinhTrang %>
                    </span>
                  </td>
                  <td class="<%= soLuongTon < 10 ? 'low-stock' : '' %>">
                    <%= soLuongTon %>
                  </td>
                  <td><%= product.daBan || 0 %></td>
                  <td><%= product.ngayNhap ? new Date(product.ngayNhap).toLocaleDateString('vi-VN') : 'N/A' %></td>
                  <td><strong><%= tongGiaTri.toLocaleString('vi-VN') %></strong></td>
                  <td>
                    <button class="btn-edit" onclick="openEditModal('<%= product.maSanPham %>', '<%= product.tinhTrang %>', <%= soLuongTon %>)" title="Chỉnh sửa">✏️</button>
                    <button class="btn-import" onclick="quickImport('<%= product.maSanPham %>')" title="Nhập hàng">📥</button>
                    <button class="btn-export" onclick="quickExport('<%= product.maSanPham %>', <%= soLuongTon %>)" title="Xuất hàng">📤</button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="11" class="no-data">Không có dữ liệu</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Sản phẩm sắp hết hàng -->
      <% if (typeof lowStockProducts !== 'undefined' && lowStockProducts && lowStockProducts.length > 0) { %>
        <div class="low-stock-section">
          <h3>⚠️ Sản phẩm sắp hết hàng</h3>
          <div class="low-stock-list">
            <% lowStockProducts.forEach(product => { %>
              <div class="low-stock-item">
                <div class="low-stock-info">
                  <strong><%= product.maSanPham %></strong> - <%= product.tenSanPham %>
                </div>
                <div class="low-stock-quantity">
                  Còn: <span class="quantity-badge"><%= product.soLuongTon %></span>
                </div>
                <button class="btn-quick-import" onclick="quickImport('<%= product.maSanPham %>')">
                  Nhập hàng
                </button>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Modal Sửa sản phẩm -->
  <div id="productModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal()">&times;</span>
      <h2>Cập nhật sản phẩm</h2>
      <form id="productForm" method="POST">
        <div class="form-group">
          <label>Mã sản phẩm:</label>
          <input type="text" id="maSP" disabled class="disabled-input" />
        </div>
        <div class="form-group">
          <label>Trạng thái:</label>
          <select name="tinhTrang" id="tinhTrang">
            <option value="Còn hàng">Còn hàng</option>
            <option value="Hết hàng">Hết hàng</option>
            <option value="Ngừng kinh doanh">Ngừng kinh doanh</option>
          </select>
        </div>
        <div class="form-group">
          <label>Số lượng tồn kho:</label>
          <input type="number" name="soLuongTon" id="soLuongTon" min="0" required />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Lưu</button>
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Hủy</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Import hàng -->
  <div id="importStockModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeImportStockModal()">&times;</span>
      <h2>Nhập hàng</h2>
      <form id="importStockForm">
        <div class="form-group">
          <label>Mã sản phẩm:</label>
          <input type="text" id="importMaSP" readonly class="disabled-input" />
        </div>
        <div class="form-group">
          <label>Số lượng nhập:</label>
          <input type="number" id="importSoLuong" min="1" value="1" required />
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-primary" onclick="submitImport()">Nhập hàng</button>
          <button type="button" class="btn btn-secondary" onclick="closeImportStockModal()">Hủy</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Export hàng -->
  <div id="exportStockModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeExportStockModal()">&times;</span>
      <h2>Xuất hàng</h2>
      <form id="exportStockForm">
        <div class="form-group">
          <label>Mã sản phẩm:</label>
          <input type="text" id="exportMaSP" readonly class="disabled-input" />
        </div>
        <div class="form-group">
          <label>Tồn kho hiện tại:</label>
          <input type="number" id="exportCurrentStock" readonly class="disabled-input" />
        </div>
        <div class="form-group">
          <label>Số lượng xuất:</label>
          <input type="number" id="exportSoLuong" min="1" value="1" required />
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-primary" onclick="submitExport()">Xuất hàng</button>
          <button type="button" class="btn btn-secondary" onclick="closeExportStockModal()">Hủy</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Import File -->
  <div id="importModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeImportModal()">&times;</span>
      <h2>Import dữ liệu từ file</h2>
      <form id="importForm">
        <div class="form-group">
          <label>Chọn file Excel hoặc CSV:</label>
          <input type="file" id="importFile" accept=".xlsx,.xls,.csv" />
          <small>Cột bắt buộc: Mã sản phẩm, Tồn kho (hoặc maSanPham, soLuongTon). File cập nhật số lượng tồn của sản phẩm đã có; không tạo sản phẩm mới. Mọi dòng phải hợp lệ để lưu.</small>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-primary" onclick="handleImport()">Import</button>
          <button type="button" class="btn btn-secondary" onclick="closeImportModal()">Hủy</button>
        </div>
      </form>
    </div>
  </div>

 <script src="/js/admin_warehouse.js"></script>
</body>
</html>
