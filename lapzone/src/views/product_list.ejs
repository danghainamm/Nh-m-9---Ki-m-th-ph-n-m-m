<!DOCTYPE html>
<html lang="vi">

<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <title>Quản lý sản phẩm</title>
  <link rel="stylesheet" href="/css/dashboard_qtv.css">
  <style>
    .product-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    .product-table th,
    .product-table td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: left;
    }

    .product-table th {
      background-color: #4CAF50;
      color: white;
    }

    .product-table tr:hover {
      background-color: #f5f5f5;
    }

    .btn {
      padding: 8px 16px;
      margin: 5px;
      text-decoration: none;
      border-radius: 4px;
      display: inline-block;
    }

    .btn-primary {
      background-color: #4CAF50;
      color: white;
    }

    .btn-danger {
      background-color: #f44336;
      color: white;
      cursor: pointer;
      border: none;
    }

    .btn-edit {
      background-color: #2196F3;
      color: white;
    }

    .header-actions {
      margin: 20px 0;
    }
  </style>
<link rel="stylesheet" href="/css/responsive.css">
</head>

<body>
  <header class="header">
    <div class="header-left">
      <img src="/images/logo.png" alt="Logo" class="logo-header">
    </div>
    <div class="user-info">
      <div class="username">
        <%= quanTriVien ? quanTriVien.hoTen : 'Admin' %>
      </div>
      <a href="/logout" class="logout">Đăng xuất</a>
    </div>
  </header>

  <div class="container">
    <div class="sidebar">
      <ul class="menu">
        <li><a href="/quanlytaikhoan">Quản lý tài khoản khách hàng</a></li>
        <li><a href="/quanlysanpham" class="active">Quản lý sản phẩm</a></li>
        <li><a href="/quanlydonhang">Quản lý đơn hàng</a></li>
        <li><a href="/xembaocao">Xem báo cáo</a></li>
        <li><a href="/quanlykho">Quản lý kho</a></li>
      </ul>
    </div>

    <div class="main-content" style="margin-left: 250px; padding: 20px;">
      <h1>Quản lý sản phẩm</h1>

      <div class="header-actions" style="display: flex; justify-content: space-between; align-items: center;">
        <a href="/quanlysanpham/create" class="btn btn-primary">+ Thêm sản phẩm mới</a>
        <form action="/quanlysanpham" method="GET" style="display: flex; gap: 10px;">
          <input type="text" name="keyword" placeholder="Tìm kiếm sản phẩm..."
            value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
            style="padding: 8px; border: 1px solid #ddd; border-radius: 4px; width: 300px;">
          <button type="submit" class="btn btn-primary">Tìm kiếm</button>
          <% if (typeof keyword !=='undefined' && keyword) { %>
            <a href="/quanlysanpham" class="btn btn-danger" style="background-color: #6c757d;">Hủy tìm</a>
            <% } %>
        </form>
      </div>

      <table class="product-table">
        <thead>
          <tr>
            <th>Mã SP</th>
            <th>Tên sản phẩm</th>
            <th>Tình trạng</th>
            <th>Số lượng tồn</th>
            <th>Giá bán</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length> 0) { %>
            <% products.forEach(product=> { %>
              <tr>
                <td>
                  <%= product.maSanPham %>
                </td>
                <td>
                  <%= product.tenSanPham %>
                </td>
                <td>
                  <%= product.tinhTrang %>
                </td>
                <td>
                  <%= product.soLuongTon %>
                </td>
                <td>
                  <%= new Intl.NumberFormat('vi-VN', { style: 'currency' , currency: 'VND' }).format(product.giaBan) %>
                </td>
                <td>
                  <a href="/quanlysanpham/edit/<%= product.maSanPham %>" class="btn btn-edit">Sửa</a>
                  <button class="btn btn-danger" onclick="deleteProduct('<%= product.maSanPham %>')">Xóa</button>
                </td>
              </tr>
              <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center;">Không có sản phẩm nào</td>
                  </tr>
                  <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    function deleteProduct(maSanPham) {
      if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) {
        fetch(`/quanlysanpham/${maSanPham}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              alert('Xóa sản phẩm thành công');
              location.reload();
            } else {
              alert('Lỗi: ' + data.message);
            }
          })
          .catch(err => alert('Lỗi khi xóa sản phẩm'));
      }
    }
  </script>
</body>

</html>
