<!DOCTYPE html>
<html lang="vi">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="UTF-8">
    <title>Thông tin chi tiết - Lapzone</title>
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/dashboard_qtv.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="/css/responsive.css">
</head>
</head>
<body>
    <!-- ===== HEADER ===== -->
    <header class="header">
      <div class="header-left">
        <div><a href="/qtv/trangchu"><img src="/images/logo.png" alt="Logo" class="logo-header" /></a></div>


      </div>
      <div class="user-info">
        <div class="username">
          <%= quanTriVien ? quanTriVien.name : 'Admin' %>
          </div>
          <a href="/logout" class="logout">Đăng xuất</a>
        </div>
    </header>

    <div class="container">
      <!-- ===== SIDEBAR ===== -->
      <div class="sidebar">
        <ul class="menu">
          <li><a href="/quanlytaikhoan">Quản lý tài khoản khách hàng</a></li>
          <li><a href="/quanlysanpham">Quản lý sản phẩm</a></li>
          <li><a href="/quanlydonhang">Quản lý đơn hàng</a></li>
          <li><a href="/xembaocao">Xem báo cáo</a></li>
          <li><a href="/quanlykho">Quản lý kho</a></li>
        </ul>
      </div>
    </div>

    <div class="main-container">
        <div class="breadcrumb">
            <a href="/quanlytaikhoan">Danh sách</a> / <span>Chi tiết tài khoản</span>
        </div>

        <div class="profile-header">
            <h2>Hồ Sơ Khách Hàng</h2>
        </div>

        <div class="profile-container">
            <div class="card profile-left">
                <div class="avatar-circle">
                    <i class="fas fa-user"></i>
                </div>
                <h3><%= user.hoTen %></h3>
                <p class="text-muted">Mã KH: <%= user.maKhachHang %></p>

                <div style="margin-top:15px;">
                    <% if(user.trangThai == 'Hoạt động') { %>
                        <span class="badge active" style="font-size: 14px;">Đang hoạt động</span>
                    <% } else { %>
                        <span class="badge locked" style="font-size: 14px;">Đã khóa</span>
                    <% } %>
                </div>
            </div>

            <div class="card profile-right">

                <div class="form-group">
                    <label>Mã Khách Hàng:</label>
                    <input type="text" value="<%= user.maKhachHang %>" readonly style="background-color: #f1f3f5; font-weight: bold;">
                </div>

                <div class="form-group">
                    <label>Tên Đăng Nhập:</label>
                    <input type="text" value="<%= user.tenDangNhap %>" readonly>
                </div>

                <div class="form-group">
                    <label>Họ và Tên:</label>
                    <input type="text" value="<%= user.hoTen %>" readonly>
                </div>

                <div class="form-group">
                    <label>Số Điện Thoại:</label>
                    <input type="text" value="<%= user.soDienThoai %>" readonly>
                </div>

                <div class="form-group">
                    <label>Email:</label>
                    <input type="text" value="<%= user.email %>" readonly>
                </div>

                <div class="form-group">
                    <label>Trạng thái:</label>
                    <input type="text" value="<%= user.trangThai %>" readonly>
                </div>

                </div>
        </div>
    </div>
</body>
</html>
