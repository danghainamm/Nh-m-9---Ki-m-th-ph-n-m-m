<!DOCTYPE html>
<html lang="vi">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8" />
  <title>Sửa đơn hàng</title>
  <link rel="stylesheet" href="/css/order_edit.css" />
<link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

<div class="edit-container">

  <div class="header">
    <h1>Sửa đơn hàng</h1>
    <a href="/quanlydonhang" class="btn-back">← Quay lại</a>
  </div>

  <!-- Thêm data attributes để truyền dữ liệu -->
  <form id="editForm"
        onsubmit="return false;"
        data-ma-don-hang="<%= order.maDonHang %>"
        data-ma-khach-hang="<%= order.maKhachHang %>"
        data-ma-dia-chi="<%= order.maDiaChi || '' %>"
        data-tong-gia-tri="<%= order.tongGiaTri || 0 %>"
        data-ghi-chu="<%= order.ghiChu || '' %>">

    <label>Trạng thái đơn hàng</label>
    <select name="trangThai" id="trangThai">
      <option selected value="<%= order.trangThai %>"><%= order.trangThai %></option>
      <option <%= order.trangThai === 'Chờ xử lý' ? 'selected' : '' %>>Chờ xử lý</option>
      <option <%= order.trangThai === 'Chờ xác nhận' ? 'selected' : '' %>>Chờ xác nhận</option>
      <option <%= order.trangThai === 'Đã xác nhận' ? 'selected' : '' %>>Đã xác nhận</option>
      <option <%= order.trangThai === 'Đang giao hàng' ? 'selected' : '' %>>Đang giao hàng</option>
      <option <%= order.trangThai === 'Đã giao hàng' ? 'selected' : '' %>>Đã giao hàng</option>
      <option <%= order.trangThai === 'Đã hủy' ? 'selected' : '' %>>Đã hủy</option>
    </select>

    <label>Tình trạng thanh toán</label>
    <select name="trangThaiThanhToan" id="trangThaiThanhToan">
      <option selected value="<%= order.phuongThucThanhToan %>"><%= order.phuongThucThanhToan %></option>
      <option <%= order.phuongThucThanhToan === 'Chưa thanh toán' ? 'selected' : '' %>>Chưa thanh toán</option>
      <option <%= order.phuongThucThanhToan === 'Chờ xử lý' ? 'selected' : '' %>>Chờ xử lý</option>
      <option <%= order.phuongThucThanhToan === 'Đã thanh toán' ? 'selected' : '' %>>Đã thanh toán</option>
    </select>

    <button type="button" class="btn-save" onclick="updateOrder()">Lưu thay đổi</button>
  </form>
</div>

<script src="/js/update_order.js"></script>

</body>
</html>
